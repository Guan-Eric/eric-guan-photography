# Copy to .env.local for local development.

# Seeded photographer password (Eric + Demo owners). Change before deploy.
ADMIN_PASSWORD=dev-admin
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
AUTH_SESSION_SECRET=replace-with-a-long-random-string
# SEED_OWNER_EMAIL=ericguan.photo@gmail.com

# Public site URL (also controls Secure cookies when http://).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_NAME=Studiofront
PLATFORM_NAME=Studiofront

# Multi-tenant host routing: {slug}.PLATFORM_ROOT_DOMAIN
PLATFORM_ROOT_DOMAIN=localhost
# PLATFORM_PUBLIC_URL=http://localhost:3000
# PLATFORM_EMAIL_FROM="Studiofront <hello@studiofront.ca>"
# PLATFORM_PUBLIC_URL=https://studiofront.ca
# Production root (studios at {slug}.studiofront.ca):
# PLATFORM_ROOT_DOMAIN=studiofront.ca

# Cron: Authorization: Bearer <CRON_SECRET> → GET/POST /api/cron/reminders
# Schedule daily (see DEPLOY.md). Required in production.
# CRON_SECRET=replace-me

# Optional: send real email via Resend. Without this, emails log to the server console.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="Studio <you@yourdomain.com>"

# Optional: Google Calendar free/busy (stubbed until wired).
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Local SQLite (default when DATABASE_URL unset). Production: Neon Postgres.
# DATABASE_PATH=./data/platform.sqlite
# DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Apply before first prod boot:
#   psql "$DATABASE_URL" -f scripts/postgres-schema.sql
#   psql "$DATABASE_URL" -f scripts/postgres-rls.sql

# Stripe Checkout + Connect (gallery unlocks + photographer subscriptions).
# Without STRIPE_SECRET_KEY, gallery checkout uses a local stub unless blocked.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
#   → Stripe Dashboard webhook URL: https://<PLATFORM_ROOT_DOMAIN>/api/stripe/webhook
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# PLATFORM_FEE_BPS=0
# Billing Price IDs (Dashboard → Products → monthly USD prices):
# STRIPE_PRICE_STARTER=price_xxx
# STRIPE_PRICE_GROWTH=price_xxx
# STRIPE_PRICE_STUDIO=price_xxx
# Customer Portal: enable in Stripe Dashboard (Billing → Customer portal).
#   App opens it via POST /api/billing/portal — no extra Portal secret.
# Connect: photographers onboard from Admin → Settings (Express accounts).

# Dev-only: allow gallery unlock without Stripe (local stub). Never enable in prod.
# ALLOW_GALLERY_STUB_UNLOCK=1

# Optional: allow cookies over http://localhost when running `next start`.
# ADMIN_COOKIE_INSECURE=1

# AppSumo Licensing API v2 (Partner Portal).
# Webhook: https://studiofront.ca/api/appsumo/webhook
# OAuth redirect: https://studiofront.ca/api/appsumo/oauth
# APPSUMO_API_KEY=
# APPSUMO_CLIENT_ID=
# APPSUMO_CLIENT_SECRET=
# Must match Partner Portal exactly (trailing slash sensitive):
# APPSUMO_REDIRECT_URI=https://studiofront.ca/api/appsumo/oauth

# Media (local default). When CLOUDFLARE_R2_* is set, uses signed S3 Put/Get.
# Without R2_FORCE_REMOTE: writes to R2 + local mirror (transition).
# With R2_FORCE_REMOTE=1: R2 only (production).
# MEDIA_ROOT=./data/media
# UPLOAD_RATE_LIMIT=60
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=studiofront-media
# CLOUDFLARE_R2_ENDPOINT=
# R2_FORCE_REMOTE=1

# Custom domain DNS check target (defaults to PLATFORM_ROOT_DOMAIN).
# CUSTOM_DOMAIN_TARGET=
